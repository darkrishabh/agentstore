# Optional: copy to .env. Defaults work without this file.
# Native Node only: SQLite file, not a PostgreSQL URL. Compose uses its named volume.
AGENTSTORE_DB_PATH=./data/agentstore.sqlite
AGENTSTORE_MCP_PORT=4311
AGENTSTORE_DASHBOARD_PORT=4310
# Leave empty for the loopback-only bundled plugins. For tunnels, use a random token
# and configure clients explicitly as described in docs/GETTING_STARTED.md.
AGENTSTORE_MCP_TOKEN=
# Development tunnel only; never publish the dashboard.
AGENTSTORE_TUNNEL_ID=
